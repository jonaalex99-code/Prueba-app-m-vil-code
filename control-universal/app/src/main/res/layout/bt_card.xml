<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de estado del Bluetooth (se usa en Mouse y Teclado) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingRight="10dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp">

        <View
            android:id="@+id/btPulse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/bg_bt_pulse" />

        <ImageView
            android:id="@+id/btCardIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bluetooth"
            android:tint="@color/muted" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btCardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btCardSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btCardAction"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:background="@drawable/bg_btn_accent"
        android:clickable="true"
        android:gravity="center"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="Conectar"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />
</LinearLayout>
