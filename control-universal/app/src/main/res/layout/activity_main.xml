<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla sin scroll: encabezado · sección (Control / Mouse / Teclado) · barra inferior -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/title"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <View
            android:id="@+id/irDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginRight="10dp"
            android:alpha="0.15"
            android:background="@drawable/bg_dot" />

        <LinearLayout
            android:id="@+id/btChip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_bt"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="12dp">

            <ImageView
                android:id="@+id/btIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bluetooth"
                android:tint="@color/muted" />

            <TextView
                android:id="@+id/btText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:ellipsize="end"
                android:maxWidth="150dp"
                android:maxLines="1"
                android:text="Bluetooth"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Secciones -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ CONTROL ============ -->
        <LinearLayout
            android:id="@+id/pageControl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="4dp"
            android:paddingRight="18dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/btnCast"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_cast"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="20dp"
                android:paddingRight="20dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cast" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cast"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/castSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#D9FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Entrada · Encender · Silencio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/btnInput"
                        style="@style/RoundBtn"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/d_input"
                        android:src="@drawable/ic_input" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/btnPower"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_power"
                    android:contentDescription="@string/d_power"
                    android:elevation="6dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_power"
                    android:tint="#FFFFFFFF" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/btnMute"
                        style="@style/RoundBtn"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/d_mute"
                        android:src="@drawable/ic_mute" />
                </FrameLayout>
            </LinearLayout>

            <!-- Volumen · Inicio/Menú/Atrás · Canal (se estira con la pantalla) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="68dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_pill"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btnVolUp"
                            style="@style/PillBtn"
                            android:contentDescription="@string/d_vol_up"
                            android:src="@drawable/ic_plus" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/volume"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />

                        <ImageButton
                            android:id="@+id/btnVolDn"
                            style="@style/PillBtn"
                            android:contentDescription="@string/d_vol_dn"
                            android:src="@drawable/ic_minus" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:id="@+id/centerCol"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnHome"
                        style="@style/RoundBtn"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/d_home"
                        android:src="@drawable/ic_home" />

                    <ImageButton
                        android:id="@+id/btnMenu"
                        style="@style/RoundBtn"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/d_menu"
                        android:src="@drawable/ic_menu" />

                    <ImageButton
                        android:id="@+id/btnBack"
                        style="@style/RoundBtn"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/d_back"
                        android:src="@drawable/ic_back" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="68dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_pill"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btnChUp"
                            style="@style/PillBtn"
                            android:contentDescription="@string/d_ch_up"
                            android:src="@drawable/ic_up" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/channel"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />

                        <ImageButton
                            android:id="@+id/btnChDn"
                            style="@style/PillBtn"
                            android:contentDescription="@string/d_ch_dn"
                            android:src="@drawable/ic_down" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Modo IR · selector Flechas / 123 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/modeChip"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:drawableLeft="@drawable/ic_tune"
                    android:drawablePadding="6dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="Universal"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_seg"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/segArrows"
                        android:layout_width="78dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/tab_arrows"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/segNumbers"
                        android:layout_width="58dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/tab_numbers"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1.35">

                <com.jonaalex.controluniversal.DpadView
                    android:id="@+id/dpad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/numbers"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- ============ MOUSE ============ -->
        <LinearLayout
            android:id="@+id/pageMouse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="4dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <include
                android:id="@+id/mouseBt"
                layout="@layout/bt_card" />

            <com.jonaalex.controluniversal.TouchpadView
                android:id="@+id/touchpad"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1" />

            <!-- Panel de calibración (se llena desde el código) -->
            <LinearLayout
                android:id="@+id/calCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingTop="10dp"
                android:paddingRight="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/clickRow"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnLeftClick"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.4"
                    android:background="@drawable/bg_click"
                    android:clickable="true"
                    android:gravity="center"
                    android:text="Clic"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnRightClick"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_click"
                    android:clickable="true"
                    android:gravity="center"
                    android:text="Clic derecho"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mouseQuick"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/mBack"
                    style="@style/RoundBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/d_back"
                    android:src="@drawable/ic_back" />

                <ImageButton
                    android:id="@+id/mHome"
                    style="@style/RoundBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="8dp"
                    android:contentDescription="@string/d_home"
                    android:src="@drawable/ic_home" />

                <ImageButton
                    android:id="@+id/mCalibrate"
                    style="@style/RoundBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_btn_accent"
                    android:contentDescription="Calibrar mouse"
                    android:src="@drawable/ic_tune" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/speedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:text="Velocidad"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/speed"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:max="100"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/mVolDn"
                    style="@style/RoundBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/d_vol_dn"
                    android:src="@drawable/ic_minus" />

                <ImageButton
                    android:id="@+id/mVolUp"
                    style="@style/RoundBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="8dp"
                    android:contentDescription="@string/d_vol_up"
                    android:src="@drawable/ic_plus" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ TECLADO ============ -->
        <LinearLayout
            android:id="@+id/pageKeyboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="4dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <include
                android:id="@+id/keyboardBt"
                layout="@layout/bt_card" />

            <EditText
                android:id="@+id/textInput"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="Escribe aquí: cada letra aparece en la TV al instante"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:padding="18dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Switch
                    android:id="@+id/liveSwitch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Enviar al instante"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:thumbTint="@color/accent" />

                <TextView
                    android:id="@+id/btnSendText"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginLeft="12dp"
                    android:background="@drawable/bg_btn_accent"
                    android:clickable="true"
                    android:drawableLeft="@drawable/ic_send"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:paddingLeft="16dp"
                    android:paddingRight="18dp"
                    android:text="Enviar"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/kLeft"
                    style="@style/KeyBtn"
                    android:contentDescription="@string/d_left"
                    android:src="@drawable/ic_left" />

                <ImageButton
                    android:id="@+id/kRight"
                    style="@style/KeyBtn"
                    android:contentDescription="@string/d_right"
                    android:src="@drawable/ic_right" />

                <ImageButton
                    android:id="@+id/kSpace"
                    style="@style/KeyBtn"
                    android:layout_weight="1.6"
                    android:contentDescription="Espacio"
                    android:src="@drawable/ic_space" />

                <ImageButton
                    android:id="@+id/kBackspace"
                    style="@style/KeyBtn"
                    android:contentDescription="Borrar"
                    android:src="@drawable/ic_backspace" />

                <ImageButton
                    android:id="@+id/kEnter"
                    style="@style/KeyBtn"
                    android:background="@drawable/bg_btn_accent"
                    android:contentDescription="Enter"
                    android:src="@drawable/ic_enter" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buscador de televisores cercanos (Wi-Fi Direct, sin red) -->
        <LinearLayout
            android:id="@+id/scanOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F20B0B0D"
            android:clickable="true"
            android:elevation="16dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="8dp"
            android:paddingRight="20dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscando televisores cerca"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sin red WiFi: el celular se conecta directo a la TV"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <com.jonaalex.controluniversal.RadarView
                android:id="@+id/radar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fadeScrollbars="true">

                <LinearLayout
                    android:id="@+id/scanList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/scanPower"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_hit"
                    android:clickable="true"
                    android:gravity="center"
                    android:text="Encender TV"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/scanSystem"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_flat"
                    android:clickable="true"
                    android:gravity="center"
                    android:text="Lista del sistema"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/scanClose"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="0.8"
                    android:background="@drawable/bg_btn_flat"
                    android:clickable="true"
                    android:gravity="center"
                    android:text="Cerrar"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Aviso flotante (búsqueda de la TV, detección) -->
        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/bg_banner"
            android:elevation="12dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/bannerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/bannerProgress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:progressTint="@color/power" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bannerYes"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_hit"
                    android:stateListAnimator="@null"
                    android:text="@string/hit"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/bannerNo"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_btn_flat"
                    android:minWidth="100dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:stateListAnimator="@null"
                    android:text="@string/stop"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Barra inferior -->
    <FrameLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@color/bg">

        <View
            android:id="@+id/navPill"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_nav_pill" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navControl"
                style="@style/NavItem">

                <ImageView
                    android:id="@+id/navControlIcon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_remote" />

                <TextView
                    android:id="@+id/navControlText"
                    style="@style/NavText"
                    android:text="Control" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navMouse"
                style="@style/NavItem">

                <ImageView
                    android:id="@+id/navMouseIcon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_mouse" />

                <TextView
                    android:id="@+id/navMouseText"
                    style="@style/NavText"
                    android:text="Mouse" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navKeyboard"
                style="@style/NavItem">

                <ImageView
                    android:id="@+id/navKeyboardIcon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_keyboard" />

                <TextView
                    android:id="@+id/navKeyboardText"
                    style="@style/NavText"
                    android:text="Teclado" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
